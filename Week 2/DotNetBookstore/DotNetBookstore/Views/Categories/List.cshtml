@model List<DotNetBookstore.Models.Category>

<h2>@ViewData["Message"]</h2>
<p>@ViewBag.Note</p>

<h1>Categories</h1>

<table class="table table-bordered table-striped">
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.CategoryId</td>
            <td>@c.Name</td>
            <td>
                <a asp-controller="Categories"
                   asp-action="Detail"
                   asp-route-id="@c.CategoryId"
                   class="btn btn-primary">
                    View
                </a>
            </td>
        </tr>
    }
</table>