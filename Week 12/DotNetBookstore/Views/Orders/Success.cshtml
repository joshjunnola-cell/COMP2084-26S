@model DotNetBookstore.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container py-5 text-center">
    <div class="card mx-auto p-4" style="max-width:720px;">
        <h1 class="h4 text-success"><i class="bi bi-check2-circle me-2"></i> Thank you — your order is confirmed</h1>
        <p class="text-muted">We've emailed your receipt. Below are the order details.</p>

        <dl class="row text-start">
            <dt class="col-sm-4">Order number</dt>
            <dd class="col-sm-8">@Model.OrderId</dd>

            <dt class="col-sm-4">Order date</dt>
            <dd class="col-sm-8">@Model.OrderDate</dd>

            <dt class="col-sm-4">Total</dt>
            <dd class="col-sm-8">@string.Format("{0:C}", Model.OrderTotal)</dd>
        </dl>

        <h5 class="mt-3">Items</h5>
        <ul class="list-group mb-3">
            @foreach (var d in Model.OrderDetails)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">@d.Book?.Title</div>
                        <div class="small text-muted">@d.Quantity × @string.Format("{0:C}", d.Price)</div>
                    </div>
                    <div class="fw-bold">@string.Format("{0:C}", d.Price * d.Quantity)</div>
                </li>
            }
        </ul>

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Continue shopping</a>
        <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary ms-2">View order</a>
    </div>
</div>