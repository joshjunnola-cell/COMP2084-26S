@model IEnumerable<DotNetBookstore.Models.Order>
@{
    ViewData["Title"] = "Order history";
}

<div class="container py-5">
    <h1 class="h4 mb-3">Order history</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You have not placed any orders yet.</div>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Start shopping</a>
    }
    else
    {
        <div class="list-group">
            @foreach (var o in Model)
            {
                <a asp-action="Details" asp-route-id="@o.OrderId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">Order #@o.OrderId</div>
                        <div class="small text-muted">@o.OrderDate — @o.OrderDetails.Sum(d => d.Quantity) items</div>
                    </div>
                    <div class="fw-bold">@string.Format("{0:C}", o.OrderTotal)</div>
                </a>
            }
        </div>
    }
</div>