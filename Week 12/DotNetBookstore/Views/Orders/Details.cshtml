@model DotNetBookstore.Models.Order
@{
    ViewData["Title"] = "Order details";
}

<div class="container py-5">
    <div class="card p-4">
        <h1 class="h5">Order #@Model.OrderId</h1>
        <div class="small text-muted mb-3">@Model.OrderDate</div>

        <h5>Shipping</h5>
        <p>@Model.FirstName @Model.LastName<br />@Model.Address<br />@Model.City, @Model.Province @Model.PostalCode<br />@Model.Phone</p>

        <h5>Items</h5>
        <ul class="list-group mb-3">
            @foreach (var d in Model.OrderDetails)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">@d.Book?.Title</div>
                        <div class="small text-muted">@d.Quantity × @string.Format("{0:C}", d.Price)</div>
                    </div>
                    <div class="fw-bold">@string.Format("{0:C}", d.Price * d.Quantity)</div>
                </li>
            }
        </ul>

        <div class="d-flex justify-content-between">
            <div class="fw-semibold">Order total</div>
            <div class="fw-bold">@string.Format("{0:C}", Model.OrderTotal)</div>
        </div>

        <div class="mt-3">
            <a asp-action="History" class="btn btn-outline-secondary">Back to history</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary ms-2">Continue shopping</a>
        </div>
    </div>
</div>